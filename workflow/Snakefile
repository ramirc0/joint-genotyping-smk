  input:
    "results/sample_map.ok",
    "results/split_interval_list.ok",
    expand("results/import_gvcfs/{scatter}.ok", scatter=range(config["params"].get("scatter_count"))),
    expand("results/genotype_gvcfs/{scatter}.ok", scatter=range(config["params"].get("scatter_count"))),
    expand("results/hard_filter/{scatter}.ok", scatter=range(config["params"].get("scatter_count"))),
    "results/gather_sites_only_vcfs.ok",
