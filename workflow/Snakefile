include: "rules/common.smk"
include: "rules/genotype.smk"
include: "rules/vets.smk"
include: "rules/qc.smk"


# The pixi plugin installs the env inside each job. Parallel SLURM jobs then race
# on a fresh or relocked env, so install it once before any job starts.
onstart:
    shell("pixi install --manifest-path {workflow.basedir:q}/envs/pixi.toml --all --locked")
    shell("rm -rf {config[tmp_dir]:q} && mkdir -p {config[tmp_dir]:q}")
    notify_slack("Snakemake Started 🚀")


onsuccess:
    notify_slack("Snakemake Finished Successfully! ✅")


onerror:
    notify_slack("Snakemake Finished With Errors! ❌")


rule all:
    input:
        f"{OUTDIR}/{CALLSET}.final.vcf.gz",
        f"{OUTDIR}/{CALLSET}.variant_calling_summary_metrics",
