sample_map: config/sample_map.tsv
callset_name: callset
outdir: results
pixi_env: default
run_id: default          # outputs go under results/<run_id>/; override per run
tmp_dir: .tmp            # GATK and Picard scratch, emptied at start; MUST NOT be a noexec mount

references:
  fasta: resources/GRCh38_no_alt_analysis_set_GCA_000001405.15.fasta
  dbsnp_vcf: resources/Homo_sapiens_assembly38.dbsnp138.vcf
  eval_interval_list: resources/wgs_evaluation_regions.hg38.interval_list
  unpadded_interval_list: resources/wgs_calling_regions.hg38.handcurated.noCentromeres.noTelomeres.interval_list
  hapmap_resource_vcf: resources/hapmap_3.3.hg38.vcf.gz
  omni_resource_vcf: resources/1000G_omni2.5.hg38.vcf.gz
  one_thousand_genomes_resource_vcf: resources/1000G_phase1.snps.high_confidence.hg38.vcf.gz
  mills_resource_vcf: resources/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz

sample_num_threshold: 50
scatter_count: 2         # about 2.5 x the number of gVCFs, as in WARP's WGS inputs
scatter_mode: INTERVAL_SUBDIVISION
batch_size: 50
excess_het_threshold: 54.69
snp_recalibration_annotation_values: [QD, MQRankSum, ReadPosRankSum, FS, MQ, SOR, DP]
snp_calibration_sensitivity_threshold: 0.997
indel_calibration_sensitivity_threshold: 0.99
